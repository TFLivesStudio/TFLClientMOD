{
  "schemaVersion": 1,
  "id": "tflcore",
  "version": "${version}",
  "name": "TFL Core",
  "description": "TFL Core: componente que impulsa las funciones del cliente TFLClient, disponible en la biblioteca TFL Selection.",
  "authors": [
    "TFLives"
  ],
  "contact": {
    "homepage": "https://launcher.tflives.com/selection",
    "sources": "https://github.com/TFLivesStudio/TFLClientMOD"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "online.tflives.tflcore.client.TflCoreClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
