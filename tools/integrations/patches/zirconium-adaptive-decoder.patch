+package net.eliotex.zirconium.utils.misc;
+
+import java.awt.image.BufferedImage;
+import java.io.*;
+import java.nio.ByteBuffer;
+import javax.imageio.ImageIO;
+
+// TFL adaptation, LGPL-3.0-only. Keep SPNG for small PNGs where it saves decoding
+// work; Java 25 ImageIO is faster for large textures. Pixels are never rescaled.
+public final class TextureImageDecoder {
+    private TextureImageDecoder() {}
+    public static BufferedImage read(InputStream stream,boolean spngAvailable)throws IOException {
+        try(BufferedInputStream input=new BufferedInputStream(stream)) {
+            input.mark(24);byte[] header=input.readNBytes(24);input.reset();
+            boolean smallPng=false;
+            if(header.length==24) {
+                ByteBuffer bytes=ByteBuffer.wrap(header);
+                if(bytes.getLong(0)==0x89504e470d0a1a0aL && bytes.getInt(12)==0x49484452) {
+                    int width=bytes.getInt(16),height=bytes.getInt(20);
+                    smallPng=width>0&&height>0&&(long)width*height<=256*256;
+                }
+            }
+            if(spngAvailable&&smallPng)return NativeBackedImage.make(input);
+            BufferedImage image=ImageIO.read(input);
+            if(image==null)throw new IOException("Unsupported texture image");
+            return image;
+        }
+    }
+}
