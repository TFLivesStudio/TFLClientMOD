+package net.eliotex.zirconium.utils.misc;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import java.awt.image.BufferedImage;
+import java.io.*;
+import javax.imageio.ImageIO;
+
+class TextureImageDecoderTest {
+    private byte[] png(int size)throws Exception {
+        BufferedImage image=new BufferedImage(size,size,BufferedImage.TYPE_INT_ARGB);
+        for(int y=0;y<size;y++)for(int x=0;x<size;x++)image.setRGB(x,y,((x&1)==0?0x80000000:0xff000000)|((x*71)^(y*117))&0xffffff);
+        ByteArrayOutputStream out=new ByteArrayOutputStream();ImageIO.write(image,"png",out);return out.toByteArray();
+    }
+    @Test void nativeSmallPngAndManagedHighResolutionHaveIdenticalFullRgbaPixels()throws Exception {
+        for(int size:new int[]{16,256,512}) {
+            byte[] png=png(size);BufferedImage expected=ImageIO.read(new ByteArrayInputStream(png));
+            BufferedImage actual=TextureImageDecoder.read(new ByteArrayInputStream(png),true);
+            assertEquals(size<=256,actual instanceof NativeBackedImage);
+            assertArrayEquals(expected.getRGB(0,0,size,size,null,0,size),actual.getRGB(0,0,size,size,null,0,size));
+        }
+    }
+    @Test void lwjgl2NeverRequiresNativeDecoderAndStreamsCloseOnFailure()throws Exception {
+        assertFalse(TextureImageDecoder.read(new ByteArrayInputStream(png(16)),false) instanceof NativeBackedImage);
+        boolean[] closed={false};InputStream bad=new ByteArrayInputStream(new byte[]{1,2,3}){public void close(){closed[0]=true;}};
+        assertThrows(IOException.class,()->TextureImageDecoder.read(bad,true));assertTrue(closed[0]);
+    }
+}
