+package net.eliotex.zirconium.utils.misc;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import java.awt.image.BufferedImage;
+import java.io.*;
+import javax.imageio.ImageIO;
+class NativeBackedImageTest {
+    private NativeBackedImage image() throws Exception {
+        BufferedImage source=new BufferedImage(5,3,BufferedImage.TYPE_INT_ARGB);
+        for(int y=0;y<3;y++)for(int x=0;x<5;x++)source.setRGB(x,y,0xff000000|(x*41)<<16|(y*73)<<8|0x32);
+        ByteArrayOutputStream encoded=new ByteArrayOutputStream();ImageIO.write(source,"png",encoded);
+        return NativeBackedImage.make(new ByteArrayInputStream(encoded.toByteArray()));
+    }
+    @Test void pngArgbCropAndScanlinesMatchImageIo() throws Exception {
+        try(NativeBackedImage image=image()) {
+            assertEquals(0xff524932,image.getRGB(2,1));
+            int[] pixels=new int[16];java.util.Arrays.fill(pixels,0x11223344);
+            image.getRGB(2,1,2,2,pixels,3,6);
+            assertEquals(image.getRGB(2,1),pixels[3]);assertEquals(image.getRGB(3,1),pixels[4]);
+            assertEquals(image.getRGB(2,2),pixels[9]);assertEquals(image.getRGB(3,2),pixels[10]);
+            assertEquals(0x11223344,pixels[0]);assertEquals(0x11223344,pixels[5]);
+            assertNotNull(image.getRGB(0,0,5,3,null,0,5));
+            image.setRGB(4,2,0x803355ee);assertEquals(0x803355ee,image.getRGB(4,2));
+        }
+    }
+    @Test void rasterSubimageAndCloseUseManagedPixelsWithoutNativeLifetimeHazards() throws Exception {
+        NativeBackedImage image=image();
+        assertThrows(ArrayIndexOutOfBoundsException.class,()->image.getRGB(4,2,2,2,new int[4],0,2));
+        int expected=image.getRGB(2,1);
+        assertEquals(expected,image.getSubimage(2,1,2,2).getRGB(0,0));
+        assertEquals(expected,((java.awt.image.DataBufferInt)image.getRaster().getDataBuffer()).getData()[7]);
+        image.close();image.close();assertEquals(expected,image.getRGB(2,1));
+    }
+}
